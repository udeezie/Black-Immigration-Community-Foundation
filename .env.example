# SMTP credentials for the contact form (api/contact.ts).
# Copy this file to ".env" and fill in the mailbox you acquire for BICF.
# On Vercel, add these as Environment Variables in the project settings instead.

# SMTP server hostname. Common values:
#   Microsoft 365 / Outlook  -> smtp.office365.com
#   Gmail / Google Workspace -> smtp.gmail.com
#   Zoho Mail                -> smtp.zoho.com
#   Most cPanel/domain hosts -> mail.yourdomain.com
SMTP_HOST=

# Port: 587 for STARTTLS (default) or 465 for implicit TLS.
SMTP_PORT=587

# Leave blank to auto-detect (true for port 465, false for 587).
# Set to "true" or "false" only if you need to override.
SMTP_SECURE=

# Mailbox login and password. Use an app password if the provider
# requires one (Gmail, Microsoft 365 with MFA, etc.).
SMTP_USER=
SMTP_PASS=

# Where contact-form submissions are delivered.
# Defaults to info@blackimmigrantscommunityfoundation.com if unset.
CONTACT_TO=

# The "From" address on outgoing mail. Defaults to SMTP_USER.
# Many providers require this to match the authenticated mailbox.
CONTACT_FROM=
